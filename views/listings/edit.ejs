<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h3>edit route</h3>
    <form method="POST" action="/listings/<%= listing.id %>?_method=PUT">
      <div>
        <label for="title">Title:</label>
        <input
          type="text"
          id="title"
          name="listing[title]"
          value="<%= listing.title %>"
          required
        />
      </div>

      <br />

      <div>
        <label for="description">Description:</label>
        <textarea id="description" name="listing[description]" required>
<%= listing.description %></textarea
        >
      </div>

      <br />

      <div>
        <label for="image">image:</label>
        <input
          type="text"
          id="image"
          name="listing[image]"
          value="<%= listing.image.url %>"
          required
        />
      </div>

      <br />

      <div>
        <label for="price">Price:</label>
        <input
          type="number"
          id="price"
          name="listing[price]"
          value="<%= listing.price %>"
          required
        />
      </div>

      <br />

      <div>
        <label for="location">Location:</label>
        <input
          type="text"
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          required
        />
      </div>

      <br />

      <div>
        <label for="country">Country:</label>
        <input
          type="text"
          id="country"
          name="listing[country]"
          value="<%= listing.country %>"
          required
        />
      </div>

      <br />

      <button type="submit">submit</button>
    </form>
  </body>
</html>
