<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h3>show details</h3>

    <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <li>&#x20B9; <%= listing.price.toLocaleString("en-IN") %></li>
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
        <a href="/listings/<%= listing._id %>/edit">edit this details</a>
        <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE"><button>delete list</button></form>
    </ul>
    
      
    
</body>
</html>